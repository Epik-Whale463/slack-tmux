# Slack credentials (Socket Mode — no public URL needed)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_SIGNING_SECRET=...

# Brain (the local LLM CLI; each Slack thread gets its own resumable opencode session)
MAIN_AGENT_CMD=opencode

# Optional: when MAIN_AGENT_CMD=opencode, point it at a local Ollama model.
# Use a model that supports tool calls; plain chat models will fail in OpenCode.
# Example: qwen2.5-coder:14b or another local coder/tool-calling model.
# OPENCODE_OLLAMA_MODEL=
# OPENCODE_OLLAMA_BASE_URL=http://localhost:11434/v1

# Worker tmux session prefix (when the brain spawns sub-agents)
TMUX_SESSION_PREFIX=slacktask

# Where telly writes its turn log (~/.telly/turns.jsonl)
TELLY_HOME=~/.telly

# Inject Playwright MCP into spawned Claude/OpenCode turns when npx is available.
# Disable with 0 to use only the built-in telly.browser helper.
TELLY_PLAYWRIGHT_MCP=1

# Comma-separated Slack user IDs allowed to mention @telly.
# STRONGLY recommended: set this to just your own user ID — the bot has no
# workdir restriction and can read/write anywhere on this machine.
ALLOWED_SLACK_USER_IDS=

LOG_LEVEL=INFO
